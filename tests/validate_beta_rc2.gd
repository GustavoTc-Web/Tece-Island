# Prepared technical scenarios. Never counted as the exploratory campaign.
extends "res://tests/validate_integration.gd"
func clock(world: Node2D, day: int, night: bool) -> void:
	var cycle: Node = world.get_node("DayNight")
	cycle.elapsed = (day - 1) * 600 + (310 if night else 10)
	cycle.refresh()
func run() -> void:
	var world := make_world({"loot_chance":0.0,"guardian_chance":0.0,"external_weapon_chance":0.0})
	world.get_node("DayNight").set_physics_process(false)
	world.get_node("Animals").set_physics_process(false)
	var inv: ResourceInventory = world.get_node("Inventory")
	var hud: CanvasLayer = world.get_node("HUD")
	var tasks: RefCounted = world.objectives.campaign_tasks
	await step()
	check(hud.crafting_view.tabs.get_child_count() == 3 and hud.crafting_view.tabs.get_children().all(func(b): return b.text != "Alimentos"), "General crafting has three useful tabs and no empty Foods tab")
	hud.set_panel("crafting")
	hud.crafting_view.search.text = "carne"
	check(not hud.crafting_view.rows.carne_cozida.visible and not hud.crafting_view.rows.peixe_cozido.visible, "General search never exposes campfire recipes")
	hud.set_panel("cooking")
	check(hud.crafting_view.rows.carne_cozida.visible and hud.crafting_view.rows.peixe_cozido.visible, "Campfire keeps both food recipes")
	hud.set_panel("")
	var fire: PlacedStructure = load("res://scenes/placed_structure.tscn").instantiate()
	fire.kind = "fogueira"
	fire.system = world.get_node("Structures")
	fire.position = world.get_node("WorldObjects/Player").position + Vector2(65,0)
	world.get_node("WorldObjects").add_child(fire)
	inv.add_resource("madeira",3)
	inv.add_resource("carne_crua",1)
	inv.add_resource("carne_peixe",1)
	fire.interact(inv)
	hud._craft("carne_cozida")
	hud._craft("peixe_cozido")
	check(inv.wood == 1 and inv.count_item("carne_crua") == 0 and inv.count_item("carne_peixe") == 0 and inv.count_item("carne_cozida") == 1 and inv.count_item("peixe_cozido") == 1, "Actual campfire cooking preserves both ingredients, one wood per meal and exact results")
	check(tasks.task("food2").done, "Meals made at the campfire satisfy the existing preparation objective")
	hud.set_panel("")
	inv.reset()
	for data in [{"item":"madeira","quantity":9},{"item":"pedra","quantity":4},{"item":"fibra","quantity":4},{"item":"linha","quantity":2},{"item":"cantil","quantity":1,"water":2},{"item":"pistola","quantity":1,"loaded":4},{"item":"espada_pedra","quantity":1}]: inv.add_item(data)
	inv.equip_slot(6)
	var pistol := inv.slot_data(5)
	check(inv.swap_slots(6, 0) and inv.slot_data(0).item == "espada_pedra" and inv.selected_index == 0, "Dragging slot seven to one swaps whole stacks and follows equipped sword")
	check(inv.swap_slots(5, 1) and inv.slot_data(1) == pistol, "Swap preserves gun UID and loaded magazine")
	check(inv.slot_data(4).water == 2 and inv.count_item("madeira") == 9, "Water and total quantities survive swaps")
	var before := JSON.stringify(inv.network_state())
	check(not inv.swap_slots(0, inv.capacity) and not inv.swap_slots(-1, 0) and JSON.stringify(inv.network_state()) == before, "Locked and nonexistent slots cannot mutate inventory")
	inv.take_slot(3, 2)
	check(inv.swap_slots(0,3) and inv.slot_data(0).is_empty() and inv.slot_data(3).item == "espada_pedra" and inv.selected_index == 3, "A whole equipped stack moves to empty destination")
	inv.reset()
	inv.add_resource("madeira", 11)
	inv.add_resource("pedra", 7)
	clock(world, 1, false)
	for id in ["machado_madeira","picareta_madeira","espada_pedra","fogueira"]: check(inv.craft(id), "Actual day-one crafting: " + id)
	check(0 in tasks.completed_stages and tasks.sleep_credits.is_empty(), "On-time completion records once and grants no sleep")
	var bed: PlacedStructure = load("res://scenes/placed_structure.tscn").instantiate()
	bed.kind = "cama"
	bed.system = world.get_node("Structures")
	bed.position = world.get_node("WorldObjects/Player").position
	world.get_node("WorldObjects").add_child(bed)
	clock(world, 1, true)
	var start: float = world.get_node("DayNight").elapsed
	check(world.get_node("Structures").use_bed(bed).contains("enfrente") and world.get_node("DayNight").elapsed == start, "Day one complete: cannot skip its normal night")
	inv.reset()
	world.objectives.crafted("arco")
	inv.add_item({"item":"carne_cozida","quantity":3})
	inv.add_item({"item":"cantil","quantity":1,"water":3})
	inv.add_item({"item":"flecha","quantity":8})
	clock(world, 4, true)
	check(tasks.sleep_credits.is_empty(), "Overdue map still missing: no sleep permission")
	world.campaign.interact("map")
	tasks.refresh_live()
	check(tasks.sleep_credits == [2], "Completing actual day-three stage on day four grants exactly one credit")
	check(world.get_node("Structures").use_bed(bed).contains("amanhecer") and world.get_node("DayNight").day_number == 5, "One overdue credit advances clock to next dawn without renumbering stages")
	check(world.campaign.map_found and world.campaign.components.is_empty() and world.campaign.encounter == "idle", "Sleep never grants components, encounters or victory")
	check(tasks.sleep_credits.is_empty() and tasks.sleep_used == [2], "Sleep consumes the exact completion permanently")
	clock(world, 5, true)
	start = world.get_node("DayNight").elapsed
	check(world.get_node("Structures").use_bed(bed).contains("enfrente") and world.get_node("DayNight").elapsed == start, "Same completion cannot skip a second night")
	inv.take_slot(0, 1)
	inv.add_item({"item":"carne_cozida","quantity":1})
	inv.swap_slots(0,1)
	tasks.refresh_live()
	check(tasks.sleep_credits.is_empty() and tasks.sleep_used == [2], "Refill and rearrange do not regrant sleep")
	var captured: Dictionary = world.progress_store.capture() if world.progress_store != null else capture(world)
	var loaded_tasks := CampaignTasks.new()
	check(loaded_tasks.restore(captured.objectives.campaign_tasks) and loaded_tasks.sleep_used == [2] and loaded_tasks.sleep_credits.is_empty(), "Save and reopen preserve used credit")
	var legacy: Dictionary = captured.objectives.campaign_tasks.duplicate(true)
	legacy.version = 1
	for field in ["completed_stages","sleep_credits","sleep_used"]: legacy.erase(field)
	check(loaded_tasks.restore(legacy) and loaded_tasks.sleep_credits.is_empty() and loaded_tasks.sleep_baseline, "Legacy migration invents no sleep achievement")
	tasks.sleep_credits.assign([2])
	tasks.sleep_used.clear()
	world.campaign.temples.lens.started = true
	check(world.get_node("Structures").use_bed(bed).contains("templo") and tasks.sleep_credits == [2], "Active temple blocks sleep without consuming permission")
	world.campaign.temples.lens.started = false
	world.campaign.encounter = "active"
	check(world.get_node("Structures").use_bed(bed).contains("ataque final") and tasks.sleep_credits == [2], "Final attack cannot be replaced by sleep")
	world.campaign.encounter = "idle"
	var house := AbandonedBuilding.new()
	house.position = Vector2(1700,768)
	world.get_node("WorldObjects").add_child(house)
	var guard: ForestCreature = load("res://scenes/forest_creature.tscn").instantiate()
	guard.origin = "guardiao"
	guard.safe_radius = 0
	guard.player = world.get_node("WorldObjects/Player")
	guard.position = house.position + Vector2(35,-25)
	world.get_node("WorldObjects").add_child(guard)
	house.register_guard(guard)
	check(house.floor_visual.get_parent() == world and house.floor_visual.get_index() < world.get_node("WorldObjects").get_index(), "Full floor draws below Y-sorted actors, separately from walls")
	var player: CharacterBody2D = world.get_node("WorldObjects/Player")
	var original_point := player.position
	player.position = guard.position + Vector2(0,10)
	check(not guard.visible and not guard.is_physics_processing() and not guard.try_attack(), "Hidden unrevealed guard cannot attack even within attack range")
	house.reveal_near(house.position + Vector2(0,170))
	check(house.interior_revealed, "Approaching entrance reveals the interior permanently")
	world.update_activity()
	check(guard.visible and guard.is_physics_processing() and guard.try_attack(), "Revealed guardian is visible and retains its normal attack")
	player.position = original_point
	house.reveal_near(Vector2.ZERO)
	check(house.interior_revealed, "Leaving entrance does not rehide a revealed fight")
	guard.receive_damage(1000)
	var interior: Dictionary = house.capture_interior()
	check(interior.cleared == [0] and AbandonedBuilding.valid_interiors({"test":interior}), "Defeated interior guardian is captured without changing spawn or reward rules")
	house.restore_interior(interior)
	check(house.cleared_guards == [0], "Restoring cleared guardian does not emit a second defeat or loot")
	clock(world,8,true)
	check(world.campaign.restore({"version":1,"discovered":true,"clues":true,"components":["lens","coil","core"],"repaired":true,"encounter":"won","attempts":1,"victory_day":7,"deaths":0}), "Prepared valid victory checkpoint for the post-win bed check")
	tasks.sleep_credits.clear()
	check(world.get_node("Structures").use_bed(bed).contains("amanhecer") and world.get_node("DayNight").day_number == 9 and world.campaign.victory_day == 7, "Continue exploring permits safe night sleep without rewriting the recorded victory")
	hud.set_panel("")
	world.queue_free()
	await step(3)
	print("BETA RC2 TECHNICAL: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)

func capture(world: Node2D) -> Dictionary:
	var store := WorldProgress.new()
	store.world = world
	return store.capture()
