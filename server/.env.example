# Public Firebase project/key default to ../config/firebase-public.json.
# Supply only the two existing authorized UIDs; never commit a real .env file.
TECE_ALLOWED_UIDS=existing_uid_1,existing_uid_2
TECE_ORIGINS=http://localhost:8060,http://127.0.0.1:8060
TECE_BIND=127.0.0.1
PORT=8787
# Production must NOT set FIREBASE_AUTH_EMULATOR_HOST or TECE_LOCAL_AUTH_TEST.
